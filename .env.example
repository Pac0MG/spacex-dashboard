# Copy to .env and fill in. Without SMTP_HOST, reset links are printed to the
# API server console instead of being emailed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
# Gmail: create an app password at https://myaccount.google.com/apppasswords
SMTP_PASS=
MAIL_FROM="SpaceX Dashboard <you@gmail.com>"
# APP_URL=http://localhost:5173
